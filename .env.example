# Everything studio writes lives here.
STUDIO_DATA_DIR=./.studio

# Dev mode returns the magic-link token in the API response instead of emailing
# it. MUST be false on any deployment a stranger can reach — it also switches
# cookies to Secure.
STUDIO_DEV_MODE=true

# Stable signing secret. Generate with: openssl rand -hex 32
# STUDIO_SECRET=

# Credits granted to a new account, and the worker pool size.
STUDIO_STARTING_CREDITS=100
STUDIO_WORKERS=2
STUDIO_SESSION_TTL=604800

# Paid jobs need the engine's provider configuration:
# FORGE3D_PROVIDER=meshy
# FORGE3D_MESHY_KEY=
