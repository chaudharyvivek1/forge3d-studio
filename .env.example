# Everything studio writes lives here.
STUDIO_DATA_DIR=./.studio

# ---------------------------------------------------------------------------
# Central authentication and billing platform
#
# Studio does not own identity or credits. Both live in the private
# auth/billing service, and these three values are studio's whole side of it.
# ---------------------------------------------------------------------------
AUTH_BILLING_API_URL=https://auth.example.com
# Which application studio is. Must match a registered app on the platform.
AUTH_BILLING_APP_ID=forge3d-studio
# Server-side only. Never expose this to a browser, never commit it.
# Generate with: openssl rand -hex 32
AUTH_BILLING_SERVICE_TOKEN=
# How long to wait on the platform before failing closed.
AUTH_BILLING_TIMEOUT_SECONDS=5

# Refuse a job kind the account is not entitled to.
STUDIO_REQUIRE_ENTITLEMENT=true
# How long a verified session is trusted without re-asking the platform.
# Revocation is only as prompt as this window.
STUDIO_SESSION_CACHE_TTL=15

# ---------------------------------------------------------------------------
# Local behaviour
# ---------------------------------------------------------------------------
# Returns the magic-link token in the API response instead of emailing it. The
# platform decides this, not studio — kept here for the local mocked setup.
STUDIO_DEV_MODE=true

# Worker pool size.
STUDIO_WORKERS=2
STUDIO_SESSION_TTL=604800

# Paid jobs need the engine's provider configuration:
# FORGE3D_PROVIDER=meshy
# FORGE3D_MESHY_KEY=
